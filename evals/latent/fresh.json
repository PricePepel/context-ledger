{
  "description": "Cycle 9 fresh set: eight questions on a second synthetic codebase (Harbor Library), written before any M2a tuning so a tuned pipeline is checked on code it was not tuned on.",
  "grading": "Since 2026-11-12 renewals, renew-on-hold and hold-expiry are graded strictly, with pattern and forbidden options (docs/evals.md, cycle 9 follow-up). Cycle 9 runs graded before that are re-graded in the eval log.",
  "fixture": "fixture-library",
  "paths": ["src/settings.js", "src/loans.js", "src/fees.js", "src/holds.js", "src/reminders.js"],
  "questions": [
    {
      "id": "loan-length",
      "question": "How long is a standard loan?",
      "required": [["21", "three weeks"]],
      "evidence": [{ "path": "src/settings.js", "lines": [7, 7] }, { "path": "src/loans.js", "lines": [15, 15] }]
    },
    {
      "id": "renewals",
      "question": "How many times can a loan be renewed, and how much time does each renewal add?",
      "required": [
        [{ "pattern": "\\b(?:2|two)\\s+(?:(?!weeks?\\b|days?\\b)[a-z]+\\s+)?(?:times|renewals)\\b" }, { "pattern": "\\btwice\\b" },
          { "pattern": "\\b(?:up to|at most|maximum of|max(?:imum)?:?)\\s+(?:2|two)\\b(?!\\s*(?:weeks?|days?)\\b)" },
          { "pattern": "\\b(?:limit|cap)\\w*\\s+(?:of\\s+|is\\s+|at\\s+|:\\s*)(?:2|two)\\b(?!\\s*(?:weeks?|days?)\\b)" }],
        ["14", "fourteen", "two weeks"]
      ],
      "evidence": [{ "path": "src/settings.js", "lines": [10, 11] }, { "path": "src/loans.js", "lines": [22, 24] }]
    },
    {
      "id": "fee-cap",
      "question": "Is there a limit on how much late fee a single loan can build up?",
      "required": [["1000", "10.00"]],
      "evidence": [{ "path": "src/settings.js", "lines": [13, 13] }, { "path": "src/fees.js", "lines": [9, 9] }]
    },
    {
      "id": "block-threshold",
      "question": "At what unpaid balance is a member blocked from borrowing?",
      "required": [["500", "5.00"]],
      "evidence": [{ "path": "src/settings.js", "lines": [14, 14] }, { "path": "src/fees.js", "lines": [16, 18] }, { "path": "src/loans.js", "lines": [13, 13] }]
    },
    {
      "id": "late-fee-rate",
      "question": "How much late fee is charged for each day a loan is overdue?",
      "required": [["25"]],
      "evidence": [{ "path": "src/fees.js", "lines": [6, 10] }]
    },
    {
      "id": "reminder-queue",
      "question": "Which queue are due-date reminders sent to?",
      "required": [["harbor-reminders"]],
      "evidence": [{ "path": "src/settings.js", "lines": [19, 19] }, { "path": "src/reminders.js", "lines": [8, 8] }]
    },
    {
      "id": "renew-on-hold",
      "question": "What happens when a member tries to renew a loan while another member has a hold on the item?",
      "required": [["on hold for another member", "refuse", "reject", "throws", "thrown", "raises", "denied", "blocked", "cannot be renewed", "can't be renewed",
        "not renewed", "cannot be extended", "can't be extended", "not extended", "fails"]],
      "forbidden": [
        { "pattern": "(?:\\bnot|\\bnever|n't|\\bcannot)(?:\\s+(?!(?:and|or|but|so|then)\\b)[a-z]+){0,2}?\\s+(?:refus|reject|throw|fail|block|stop|den(?:y|ied))" },
        { "pattern": "(?<!(?:\\bnot|\\bnever|n't|\\bcannot)(?:\\s+(?!(?:and|or|but|so|then)\\b)[a-z]+){0,2}\\s+)\\bsucceed" },
        { "pattern": "(?<!(?:\\bnot|\\bnever|n't|\\bcannot)(?:\\s+(?!(?:and|or|but|so|then)\\b)[a-z]+){0,2}\\s+)\\bgoes through\\b" },
        { "pattern": "\\bno (?:error|exception)s?\\b(?!\\s+(?:is|was|will be) made)" },
        { "pattern": "(?<!(?:\\bnot|\\bnever|n't|\\bcannot)(?:\\s+(?!(?:and|or|but|so|then)\\b)[a-z]+){0,2}\\s+)\\ballowed to renew" },
        { "pattern": "(?<!(?:\\bnot|\\bnever|n't|\\bcannot)(?:\\s+(?!(?:and|or|but|so|then)\\b)[a-z]+){0,2}\\s+)\\b(?:is|are|gets|get) (?:still )?extended\\b" },
        "is still renewed", "can still be renewed", "renewal is allowed"
      ],
      "evidence": [{ "path": "src/loans.js", "lines": [23, 23] }, { "path": "src/holds.js", "lines": [12, 14] }]
    },
    {
      "id": "hold-expiry",
      "question": "What happens to a hold when the member does not pick the item up from the hold shelf in time?",
      "required": [
        ["expire"],
        [{ "pattern": "\\b(?:next|second|following|earliest)(?:\\s+(?!(?:day|week|time|morning|reminder)\\b)['\"]?[a-z-]+['\"]?){0,2}\\s+(?:member|hold|person|patron|borrower|in (?:the )?(?:queue|line))\\b" },
          { "pattern": "\\b(?:promot\\w*|puts?|moves?)\\s+(?:the\\s+|a\\s+|an\\s+|another\\s+)?(?:next|following|second|earliest|first\\s+(?:waiting|queued)|waiting|queued)\\b(?:\\s+['\"]?[a-z-]+['\"]?){0,2}?\\s+(?:hold|member)\\b" },
          { "pattern": "\\bfirst\\s+(?:(?:waiting|queued)\\s+(?:member|hold|person|patron|borrower)\\b|(?:member|hold|person|patron|borrower)\\s+in (?:the )?(?:queue|line)\\b)" }],
        [{ "pattern": "\\bpromot|on-shelf|\\b(?:on|onto|to) (?:the )?(?:hold )?shelf\\b|\\bavailable\\b|\\b(?:gets?|receives?|is offered|can (?:collect|pick up|borrow)) (?:the item|it)\\b|\\b(?:offered|goes|passes|handed|given) to\\b|\\bits turn\\b" }]
      ],
      "forbidden": [{ "pattern": "(?:\\bnot|\\bnever|n't|\\bcannot)(?:\\s+(?!(?:and|or|but|so|then)\\b)[a-z]+){0,2}?\\s+expire" }],
      "evidence": [{ "path": "src/holds.js", "lines": [25, 31] }]
    }
  ]
}
