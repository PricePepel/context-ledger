      "slice": { "answer": "Sessions last 1800 s and a refresh adds 9000 s." },
      "expected": { "correct": false, "cited": false }, "note": "900 inside 9000" },
    { "questionRef": { "file": "evals/latent/questions.json", "id": "tax-rate" },
      "slice": { "answer": "The tax rate is 0.2." },
      "expected": { "correct": true, "cited": false }, "note": "a full stop after the number is not a decimal" },
