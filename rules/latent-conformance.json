{
  "about": "Cases that both languages must decide the same way. tests/latent-rules.test.mjs runs them against src/latent.mjs and evals/latent/grade.mjs; runtime/tests/test_rule_conformance.py runs them against runtime/latent_pool and runtime/tests/grade.py. Invisible characters are written as JSON escapes. Expected values are today's behaviour (cycle 10), except where the two languages disagreed before H4; those cases carry a note.",
  "secretPaths": [
    { "path": ".env", "secret": true },
    { "path": ".context-ledger/ledger.sqlite.token", "secret": true, "note": "P1e: the ledger's access token file before it was per port" },
    { "path": ".context-ledger/ledger.sqlite.4317.token", "secret": true, "note": "P1e: the ledger's access token file for port 4317" },
    { "path": "data/LEDGER.SQLITE.TOKEN", "secret": true, "note": "suffix case is folded" },
    { "path": "docs/token.md", "secret": false, "note": "only the .token suffix is secret" },
    { "path": ".ENV", "secret": true, "note": "case is folded" },
    { "path": "a/.env", "secret": true },
    { "path": ".env.local", "secret": true },
    { "path": "config/deploy/.env.production", "secret": true },
    { "path": ".envrc", "secret": true, "note": "prefix rule: anything starting .env" },
    { "path": ".environment", "secret": true, "note": "prefix rule: anything starting .env" },
    { "path": ".env.example.local", "secret": true, "note": "only the exact template names are allowed" },
    { "path": ".git/config", "secret": true },
    { "path": "src/.GIT/HEAD", "secret": true, "note": "directory case is folded" },
    { "path": "a/b/c/.ssh/known_hosts", "secret": true, "note": "a secret directory anywhere before the name" },
    { "path": "home/.aws/credentials", "secret": true },
    { "path": ".gnupg/pubring.kbx", "secret": true },
    { "path": ".docker/config.json", "secret": true },
    { "path": ".kube/config", "secret": true },
    { "path": ".npmrc", "secret": true },
    { "path": "pkg/.PyPIRC", "secret": true },
    { "path": ".netrc", "secret": true },
    { "path": ".pgpass", "secret": true },
    { "path": ".git-credentials", "secret": true },
    { "path": "credentials", "secret": true },
    { "path": "deploy/Credentials", "secret": true },
    { "path": "id_rsa", "secret": true },
    { "path": "keys/id_rsa.pub", "secret": true, "note": "prefix rule, so public halves are refused too" },
    { "path": "id_dsa", "secret": true },
    { "path": "id_ecdsa", "secret": true },
    { "path": "keys/id_ed25519", "secret": true },
    { "path": "ID_ED25519.old", "secret": true },
    { "path": "keys/server.pem", "secret": true },
    { "path": "tls/server.KEY", "secret": true },
    { "path": "server.\u212Aey", "secret": true, "note": "KELVIN SIGN lower-cases to k in both languages" },
    { "path": "certs/client.p12", "secret": true },
    { "path": "a.pfx", "secret": true },
    { "path": "release.keystore", "secret": true },
    { "path": "android/app/debug.jks", "secret": true },
    { "path": ".env.example", "secret": false },
    { "path": "app/.ENV.Example", "secret": false, "note": "templates match after lower-casing" },
    { "path": ".env.sample", "secret": false },
    { "path": ".env.template", "secret": false },
    { "path": "env.txt", "secret": false },
    { "path": "src/env.js", "secret": false },
    { "path": "environment.ts", "secret": false },
    { "path": ".github/workflows/e2e.yml", "secret": false },
    { "path": ".gitignore", "secret": false },
    { "path": "worktree/.git", "secret": false, "note": "secret directories count only before the last segment" },
    { "path": "docs/.ssh", "secret": false, "note": "secret directories count only before the last segment" },
    { "path": "notes/git/config", "secret": false },
    { "path": "src/keyboard.js", "secret": false },
    { "path": "monkey", "secret": false },
    { "path": "public.key.txt", "secret": false },
    { "path": "a.pem.bak", "secret": false },
    { "path": "id_ecdsa.pub", "secret": false, "note": "id_dsa and id_ecdsa are exact names, not prefixes" },
    { "path": "my_id_rsa", "secret": false },
    { "path": "credentials.json", "secret": false },
    { "path": "src/config.js", "secret": false }
  ],
  "quoteWhitespace": [
    { "text": "a  b", "folded": "a b" },
    { "text": "\ta\tb\t", "folded": "a b" },
    { "text": "a\r\nb\u000bc\u000cd", "folded": "a b c d" },
    { "text": "a\u00A0b", "folded": "a b", "note": "NBSP" },
    { "text": "\u00A0\u00A0lead and trail\u3000", "folded": "lead and trail" },
    { "text": "a\u2028b\u2029c", "folded": "a b c", "note": "line and paragraph separators" },
    { "text": "a\u3000\u2003b", "folded": "a b" },
    { "text": "a\u2000\u200Ab", "folded": "a b" },
    { "text": "a\u1680b\u202Fc\u205Fd", "folded": "a b c d" },
    { "text": "\uFEFFa b", "folded": "a b", "note": "U+FEFF is \\s in JavaScript" },
    { "text": "a\u001cb", "folded": "a\u001cb", "note": "Python str.split() would split here; the ledger does not" },
    { "text": "a\u001fb", "folded": "a\u001fb" },
    { "text": "a\u0085b", "folded": "a\u0085b", "note": "NEL is not \\s in JavaScript" },
    { "text": "a\u200Bb", "folded": "a\u200Bb", "note": "zero-width space is not whitespace" },
    { "text": "a\u180Eb", "folded": "a\u180Eb", "note": "Mongolian vowel separator left \\s in Unicode 6.3" },
    { "text": "a \u200D b", "folded": "a \u200D b" },
    { "text": "x\uD83D\uDE00  y", "folded": "x\uD83D\uDE00 y" },
    { "text": "  ", "folded": "" },
    { "text": "", "folded": "" },
    { "text": "  if (items.length >  LIMIT) throw new Error('too big');", "folded": "if (items.length > LIMIT) throw new Error('too big');" }
  ],
  "grader": [
    { "questionRef": { "file": "evals/latent/questions.json", "id": "charge-retries" },
      "slice": { "answer": "Retried 3 times, 250 ms, doubling.", "findings": [{ "label": "retry loop", "evidence": [{ "path": "src/payments.js", "startLine": 12, "endLine": 14 }] }] },
      "expected": { "correct": true, "cited": true } },
    { "questionRef": { "file": "evals/latent/questions.json", "id": "charge-retries" },
      "slice": { "answer": "Waits 30 minutes, then 1250 ms, doubling." },
      "expected": { "correct": false, "cited": false },
      "note": "wrong value: 3 inside 30 and 250 inside 1250. Before H4 the Python port matched substrings and graded this correct." },
    { "questionRef": { "file": "evals/latent/questions.json", "id": "charge-retries" },
      "slice": { "answer": "Retried 3.5 times, 250 ms, doubling." },
      "expected": { "correct": false, "cited": false }, "note": "wrong value: 3 is not 3.5" },
    { "questionRef": { "file": "evals/latent/questions.json", "id": "charge-retries" },
      "slice": { "answer": "Limit 13, base 2500 ms, doubling." },
      "expected": { "correct": false, "cited": false }, "note": "wrong value" },
    { "questionRef": { "file": "evals/latent/questions.json", "id": "charge-retries" },
      "slice": { "answer": "Retry limit: 3; base 250ms; it doubles." },
      "expected": { "correct": true, "cited": false }, "note": "a unit glued to 250 is still 250" },
    { "questionRef": { "file": "evals/latent/questions.json", "id": "charge-retries" },
      "slice": { "answer": "Retried 3 times", "findings": [{ "label": "RETRY_BASE_MS is 250, doubling", "evidence": [] }] },
      "expected": { "correct": true, "cited": false }, "note": "finding labels count toward required groups" },
    { "questionRef": { "file": "evals/latent/questions.json", "id": "charge-retries" },
      "slice": { "answer": "THREE retries from 250 ms with 2 ** attempt." },
      "expected": { "correct": true, "cited": false }, "note": "case-insensitive" },
    { "questionRef": { "file": "evals/latent/questions.json", "id": "charge-retries" },
      "slice": { "answer": "Retried 3 times, 250 ms, then 12 ** n." },
      "expected": { "correct": false, "cited": false }, "note": "the option 2 ** must not match inside 12 **" },
    { "questionRef": { "file": "evals/latent/questions.json", "id": "charge-retries" },
      "slice": { "answer": "Retried 3 times, 250 ms, doubling.", "findings": [{ "label": "retry loop", "evidence": [{ "path": "src/payments.js", "startLine": 23, "endLine": 30 }] }] },
      "expected": { "correct": true, "cited": false }, "note": "wrong citation: lines after the acceptable span" },
    { "questionRef": { "file": "evals/latent/questions.json", "id": "charge-retries" },
      "slice": { "answer": "Retried 3 times, 250 ms, doubling.", "findings": [{ "label": "retry loop", "evidence": [{ "path": "src/orders.js", "startLine": 11, "endLine": 22 }] }] },
      "expected": { "correct": true, "cited": false }, "note": "wrong citation: right lines, wrong file" },
    { "questionRef": { "file": "evals/latent/questions.json", "id": "charge-retries" },
      "slice": { "answer": "Retried 3 times, 250 ms, doubling.", "findings": [{ "label": "config", "evidence": [{ "path": "src/config.js", "startLine": 22, "endLine": 40 }] }] },
      "expected": { "correct": true, "cited": true }, "note": "a span that touches the acceptable span's last line overlaps it" },
    { "questionRef": { "file": "evals/latent/questions.json", "id": "session-lifetime" },
      "slice": { "answer": "Sessions last 30 minutes and a refresh adds 15 minutes." },
