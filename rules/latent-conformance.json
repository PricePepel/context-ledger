      "slice": { "answer": "The tax rate is 0.25." },
      "expected": { "correct": false, "cited": false } },
    { "questionRef": { "file": "evals/latent/questions.json", "id": "refund-window" },
      "slice": { "answer": "Refunds are possible for 140 days." },
      "expected": { "correct": false, "cited": false } },
    { "question": { "id": "strict", "required": [[{ "pattern": "\\bup to 2\\b" }]], "forbidden": ["not"], "evidence": [] },
      "slice": { "answer": "Up to 2 times." },
      "expected": { "correct": true, "cited": false }, "note": "pattern option, case-insensitive" },
    { "question": { "id": "strict", "required": [[{ "pattern": "\\bup to 2\\b" }]], "forbidden": ["not"], "evidence": [] },
      "slice": { "answer": "Up to 20 times." },
      "expected": { "correct": false, "cited": false } },
    { "question": { "id": "strict", "required": [[{ "pattern": "\\bup to 2\\b" }]], "forbidden": ["not"], "evidence": [] },
      "slice": { "answer": "Not up to 2 times." },
      "expected": { "correct": false, "cited": false }, "note": "forbidden option. Before H4 the Python port ignored forbidden options." },
    { "question": { "id": "strict", "required": [[{ "pattern": "\\bup to 2\\b" }]], "forbidden": ["not"], "evidence": [] },
      "slice": { "answer": "Up to 2 times.", "findings": [{ "label": "not more", "evidence": [] }] },
      "expected": { "correct": true, "cited": false }, "note": "forbidden options read the answer only" },
    { "question": { "id": "spaces", "required": [[{ "pattern": "\\bup\\s+to\\s+2\\b" }]], "evidence": [] },
      "slice": { "answer": "Up\u00A0to 2 times." },
      "expected": { "correct": true, "cited": false }, "note": "\\s in a pattern matches NBSP, as in JavaScript" },
    { "question": { "id": "non-space", "required": [[{ "pattern": "^\\S+$" }]], "evidence": [] },
      "slice": { "answer": "abc\u3000" },
      "expected": { "correct": false, "cited": false }, "note": "\\S does not match U+3000" },
    { "question": { "id": "ascii-word", "required": [[{ "pattern": "caf\\w" }]], "evidence": [] },
      "slice": { "answer": "Le caf\u00E9." },
      "expected": { "correct": false, "cited": false }, "note": "\\w is ASCII only in JavaScript" },
    { "question": { "id": "ascii-digit", "required": [[{ "pattern": "\\d" }]], "evidence": [] },
      "slice": { "answer": "\u0663 items" },
      "expected": { "correct": false, "cited": false }, "note": "\\d is ASCII only in JavaScript" },
    { "question": { "id": "nothing", "required": [["x"]], "evidence": [{ "path": "a.js", "lines": [1, 2] }] },
      "slice": { "findings": [{ "evidence": [{ "path": "a.js", "startLine": 2, "endLine": 3 }] }] },
      "expected": { "correct": false, "cited": true }, "note": "no answer and no label are empty text" },
