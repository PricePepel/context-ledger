{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Context Ledger semantic graph v2",
  "description": "A cited snapshot of what one party wants, offers, has decided and still needs, with links to nodes in other parties' graphs.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "sessionId", "party", "nodes", "edges"],
  "properties": {
    "version": { "const": 2 },
    "sessionId": { "$ref": "#/$defs/hash" },
    "party": { "$ref": "#/$defs/party" },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": { "$ref": "#/$defs/node" }
    },
    "edges": {
      "type": "array",
      "maxItems": 300,
      "items": { "$ref": "#/$defs/edge" }
    },
    "links": {
      "type": "array",
      "maxItems": 100,
      "items": { "$ref": "#/$defs/link" }
    }
  },
  "$defs": {
    "hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "party": {
      "type": "string",
      "maxLength": 32,
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "nodeId": {
      "type": "string",
      "maxLength": 64,
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "label"],
      "properties": {
        "id": { "$ref": "#/$defs/nodeId" },
        "kind": { "enum": ["goal", "decision", "constraint", "offer", "action", "blocker", "question"] },
        "label": {
          "type": "string",
          "maxLength": 500,
          "description": "One line of visible text: no control characters, line or paragraph separators, or bidi controls.",
          "allOf": [
            { "type": "string", "pattern": "[^\\s\\p{C}\\p{M}\\u115F\\u1160\\u3164\\uFFA0\\u2800]" },
            { "type": "string", "pattern": "^[^\\p{Cc}\\p{Zl}\\p{Zp}\\u061C\\u200E\\u200F\\u202A-\\u202E\\u2066-\\u2069]*$" }
          ]
        },
        "evidenceLines": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "uniqueItems": true,
          "items": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
          "description": "Transcript line numbers of the stored turns this node comes from. Give evidenceLines, evidenceQuotes or both."
        },
        "evidenceQuotes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": { "type": "string", "minLength": 8, "maxLength": 400 },
          "description": "Verbatim text from the session that supports this node, 8 to 400 characters each. The ledger finds the latest stored turn that contains each quote (case, spacing and quote or dash style do not matter) and stores its line number instead."
        },
        "status": { "type": "string" },
        "to": { "$ref": "#/$defs/party" }
      },
      "allOf": [
        {
          "anyOf": [
            { "required": ["evidenceLines"], "properties": { "evidenceLines": {} } },
            { "required": ["evidenceQuotes"], "properties": { "evidenceQuotes": {} } }
          ]
        },
        {
          "if": { "properties": { "kind": { "const": "action" } } },
          "then": { "required": ["status"], "properties": { "status": { "enum": ["pending", "completed"] } } }
        },
        {
          "if": { "properties": { "kind": { "const": "blocker" } } },
          "then": { "required": ["status"], "properties": { "status": { "enum": ["open", "resolved"] } } }
        },
        {
          "if": { "properties": { "kind": { "const": "question" } } },
          "then": {
            "required": ["status", "to"],
            "properties": { "status": { "enum": ["open", "answered"] }, "to": { "$ref": "#/$defs/party" } }
          },
          "else": { "not": { "required": ["to"] } }
        },
        {
          "if": { "properties": { "kind": { "enum": ["goal", "decision", "constraint", "offer"] } } },
          "then": { "not": { "required": ["status"] } }
        }
      ]
    },
    "edge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from", "to", "type"],
      "properties": {
        "from": { "$ref": "#/$defs/nodeId" },
        "to": { "$ref": "#/$defs/nodeId" },
        "type": {
          "enum": ["advances", "blocks", "depends_on", "supersedes", "constrains", "answers"],
          "description": "Node kinds, from → to: advances action→goal, blocks blocker→action, depends_on action→action, supersedes decision→decision (new → replaced), constrains constraint→action, answers decision→question."
        }
      }
    },
    "link": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from", "graph", "to", "type"],
      "properties": {
        "from": { "$ref": "#/$defs/nodeId" },
        "graph": { "$ref": "#/$defs/hash" },
        "to": { "$ref": "#/$defs/nodeId" },
        "type": {
          "enum": ["matches", "conflicts", "answers"],
          "description": "Node kinds, local → remote: matches goal/offer/action → goal/offer/action; conflicts goal/offer/action/constraint/decision → the same kinds; answers decision → a question addressed to this party. A link cannot start or end at a superseded decision."
        }
      }
    }
  }
}
