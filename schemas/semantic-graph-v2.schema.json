{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Context Ledger semantic graph v2",
  "description": "A cited snapshot of what one party wants, offers, has decided and still needs, with links to nodes in other parties' graphs.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "sessionId", "party", "nodes", "edges"],
  "properties": {
    "version": { "const": 2 },
    "sessionId": { "$ref": "#/$defs/hash" },
    "party": { "$ref": "#/$defs/party" },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": { "$ref": "#/$defs/node" }
    },
    "edges": {
      "type": "array",
      "maxItems": 300,
      "items": { "$ref": "#/$defs/edge" }
    },
    "links": {
      "type": "array",
      "maxItems": 100,
      "items": { "$ref": "#/$defs/link" }
    }
  },
  "$defs": {
    "hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "party": {
      "type": "string",
      "maxLength": 32,
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "nodeId": {
      "type": "string",
      "maxLength": 64,
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "label", "evidenceLines"],
      "properties": {
        "id": { "$ref": "#/$defs/nodeId" },
        "kind": { "enum": ["goal", "decision", "constraint", "offer", "action", "blocker", "question"] },
        "label": { "type": "string", "maxLength": 500, "pattern": "\\S" },
        "evidenceLines": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "uniqueItems": true,
          "items": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 }
        },
        "status": { "type": "string" },
        "to": { "$ref": "#/$defs/party" }
      },
      "allOf": [
        {
          "if": { "properties": { "kind": { "const": "action" } } },
          "then": { "required": ["status"], "properties": { "status": { "enum": ["pending", "completed"] } } }
        },
        {
          "if": { "properties": { "kind": { "const": "blocker" } } },
          "then": { "required": ["status"], "properties": { "status": { "enum": ["open", "resolved"] } } }
        },
        {
          "if": { "properties": { "kind": { "const": "question" } } },
          "then": {
            "required": ["status", "to"],
            "properties": { "status": { "enum": ["open", "answered"] }, "to": { "$ref": "#/$defs/party" } }
          },
          "else": { "not": { "required": ["to"] } }
        },
        {
          "if": { "properties": { "kind": { "enum": ["goal", "decision", "constraint", "offer"] } } },
          "then": { "not": { "required": ["status"] } }
        }
      ]
    },
    "edge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from", "to", "type"],
      "properties": {
        "from": { "$ref": "#/$defs/nodeId" },
        "to": { "$ref": "#/$defs/nodeId" },
        "type": { "enum": ["advances", "blocks", "depends_on", "supersedes", "constrains", "answers"] }
      }
    },
    "link": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from", "graph", "to", "type"],
      "properties": {
        "from": { "$ref": "#/$defs/nodeId" },
        "graph": { "$ref": "#/$defs/hash" },
        "to": { "$ref": "#/$defs/nodeId" },
        "type": { "enum": ["matches", "conflicts", "answers"] }
      }
    }
  }
}
