{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Context Ledger semantic graph v3",
  "description": "A cited snapshot of what one party wants, offers, has decided and still needs, with links to nodes in other parties' graphs. Each node cites stored messages by key, or registered artifacts, instead of line numbers.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "sessionId",
    "party",
    "nodes",
    "edges"
  ],
  "properties": {
    "version": {
      "const": 3
    },
    "sessionId": {
      "$ref": "#/$defs/hash"
    },
    "party": {
      "$ref": "#/$defs/party"
    },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "$ref": "#/$defs/node"
      }
    },
    "edges": {
      "type": "array",
      "maxItems": 300,
      "items": {
        "$ref": "#/$defs/edge"
      }
    },
    "links": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "$ref": "#/$defs/link"
      }
    }
  },
  "$defs": {
    "hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "party": {
      "type": "string",
      "maxLength": 32,
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "nodeId": {
      "type": "string",
      "maxLength": 64,
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "label",
        "evidence"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/nodeId"
        },
        "kind": {
          "enum": [
            "goal",
            "decision",
            "constraint",
            "offer",
            "action",
            "blocker",
            "question"
          ]
        },
        "label": {
          "type": "string",
          "maxLength": 500,
          "description": "One line of visible text: no control characters, line or paragraph separators, or bidi controls.",
          "allOf": [
            {
              "type": "string",
              "pattern": "[^\\s\\p{C}\\p{M}\\u115F\\u1160\\u3164\\uFFA0\\u2800]"
            },
            {
              "type": "string",
              "pattern": "^[^\\p{Cc}\\p{Zl}\\p{Zp}\\u061C\\u200E\\u200F\\u202A-\\u202E\\u2066-\\u2069]*$"
            }
          ]
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "uniqueItems": true,
          "description": "What the node rests on: messages of the packet's session by key (from session_read), or artifacts registered in its project.",
          "items": {
            "$ref": "#/$defs/citation"
          }
        },
        "status": {
          "type": "string"
        },
        "to": {
          "$ref": "#/$defs/party"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "action"
              }
            }
          },
          "then": {
            "required": [
              "status"
            ],
            "properties": {
              "status": {
                "enum": [
                  "pending",
                  "completed"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "blocker"
              }
            }
          },
          "then": {
            "required": [
              "status"
            ],
            "properties": {
              "status": {
                "enum": [
                  "open",
                  "resolved"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "question"
              }
            }
          },
          "then": {
            "required": [
              "status",
              "to"
            ],
            "properties": {
              "status": {
                "enum": [
                  "open",
                  "answered"
                ]
              },
              "to": {
                "$ref": "#/$defs/party"
              }
            }
          },
          "else": {
            "not": {
              "required": [
                "to"
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "enum": [
                  "goal",
                  "decision",
                  "constraint",
                  "offer"
                ]
              }
            }
          },
          "then": {
            "not": {
              "required": [
                "status"
              ]
            }
          }
        }
      ]
    },
    "edge": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "from",
        "to",
        "type"
      ],
      "properties": {
        "from": {
          "$ref": "#/$defs/nodeId"
        },
        "to": {
          "$ref": "#/$defs/nodeId"
        },
        "type": {
          "enum": [
            "advances",
            "blocks",
            "depends_on",
            "supersedes",
            "constrains",
            "answers"
          ],
          "description": "Node kinds, from → to: advances action→goal, blocks blocker→action, depends_on action→action, supersedes decision→decision (new → replaced), constrains constraint→action, answers decision→question."
        }
      }
    },
    "link": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "from",
        "graph",
        "to",
        "type"
      ],
      "properties": {
        "from": {
          "$ref": "#/$defs/nodeId"
        },
        "graph": {
          "$ref": "#/$defs/hash"
        },
        "to": {
          "$ref": "#/$defs/nodeId"
        },
        "type": {
          "enum": [
            "matches",
            "conflicts",
            "answers"
          ],
          "description": "Node kinds, local → remote: matches goal/offer/action → goal/offer/action; conflicts goal/offer/action/constraint/decision → the same kinds; answers decision → a question addressed to this party. A link cannot start or end at a superseded decision."
        }
      }
    },
    "messageKey": {
      "type": "string",
      "maxLength": 64,
      "pattern": "^(?:u:[0-9A-Fa-f]{8}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{12}|h:[0-9a-f]{32}|l:[1-9][0-9]{0,15})$"
    },
    "citation": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "message"
          ],
          "properties": {
            "message": {
              "$ref": "#/$defs/messageKey"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "artifact"
          ],
          "properties": {
            "artifact": {
              "$ref": "#/$defs/hash"
            }
          }
        }
      ]
    }
  }
}
