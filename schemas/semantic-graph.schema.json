{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Context Ledger semantic graph v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "sessionId", "nodes", "edges"],
  "properties": {
    "version": { "const": 1 },
    "sessionId": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": { "$ref": "#/$defs/node" }
    },
    "edges": {
      "type": "array",
      "maxItems": 300,
      "items": { "$ref": "#/$defs/edge" }
    }
  },
  "$defs": {
    "nodeId": {
      "type": "string",
      "maxLength": 64,
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "label", "evidenceLines"],
      "properties": {
        "id": { "$ref": "#/$defs/nodeId" },
        "kind": { "enum": ["goal", "decision", "constraint", "action", "blocker"] },
        "label": { "type": "string", "maxLength": 500, "pattern": "\\S" },
        "evidenceLines": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "uniqueItems": true,
          "items": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 }
        },
        "status": { "type": "string" }
      },
      "if": { "properties": { "kind": { "const": "action" } } },
      "then": {
        "required": ["status"],
        "properties": { "status": { "enum": ["pending", "completed"] } }
      },
      "else": {
        "if": { "properties": { "kind": { "const": "blocker" } } },
        "then": {
          "required": ["status"],
          "properties": { "status": { "enum": ["open", "resolved"] } }
        },
        "else": { "not": { "required": ["status"] } }
      }
    },
    "edge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from", "to", "type"],
      "properties": {
        "from": { "$ref": "#/$defs/nodeId" },
        "to": { "$ref": "#/$defs/nodeId" },
        "type": { "enum": ["advances", "blocks", "depends_on", "supersedes", "constrains"] }
      }
    }
  }
}
